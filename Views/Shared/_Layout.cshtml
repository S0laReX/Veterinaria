<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>@ViewData["Title"] · Huellitas</title>
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>
<body>
<a href="#contenido" class="skip-link">Saltar al contenido</a>
<header class="site-header">
<nav class="navbar navbar-expand-xl">
<div class="container">
<a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
<span class="brand-mark" aria-hidden="true">✚</span> huellitas<span class="brand-sub">CLÍNICA VETERINARIA</span>
</a>
<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Abrir navegación">
<span class="navbar-toggler-icon">
</span>
</button>
<div class="collapse navbar-collapse" id="mainNavbar">
<ul class="navbar-nav mx-auto gap-xl-2">
<li class="nav-item">
<a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
</li>
<li class="nav-item">
<a class="nav-link" asp-area="" asp-controller="Home" asp-action="Servicios">Servicios</a>
</li>
@if(User.IsInRole("Administrador")) {
<li class="nav-item">
<a class="nav-link" asp-area="" asp-controller="Servicios" asp-action="Index">Gestionar servicios</a>
</li>
<li class="nav-item">
<a class="nav-link" asp-area="" asp-controller="Citas" asp-action="Index">Citas</a>
</li>
<li class="nav-item">
<a class="nav-link" asp-area="" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
</li>
<li class="nav-item">
<a class="nav-link" asp-area="" asp-controller="Reportes" asp-action="Index">Reportes</a>
</li>
} else if(User.IsInRole("Cliente")) {
<li class="nav-item">
<a class="nav-link" asp-area="" asp-controller="Mascotas" asp-action="Index">Mis mascotas</a>
</li>
<li class="nav-item">
<a class="nav-link" asp-area="" asp-controller="Citas" asp-action="Index">Mis citas</a>
</li>
}
</ul>
<partial name="_LoginPartial"/>
</div>
</div>
</nav>
</header>
<main id="contenido" tabindex="-1">
<div class="container">
@if(TempData["Success"] is string success) { <div class="alert alert-success mt-3" role="status">@success</div> }
@if(TempData["Error"] is string error) { <div class="alert alert-danger mt-3" role="alert">@error</div> }
</div>@RenderBody()</main>
<footer class="site-footer">
<div class="container">
<div class="row g-4">
<div class="col-md-6">
<a class="footer-brand" asp-area="" asp-controller="Home" asp-action="Index">✚ huellitas</a>
<p>Cuidamos a quienes hacen más feliz tu vida.</p>
</div>
<div class="col-md-3">
<h2>Su bienestar</h2>
<a asp-area="" asp-controller="Home" asp-action="Servicios">Nuestros servicios</a>
@if (!User.IsInRole("Administrador")) { <a asp-area="" asp-controller="Citas" asp-action="Create">Solicitar una cita</a> }
</div>
<div class="col-md-3">
<h2>Tu espacio</h2>
@if (User.IsInRole("Administrador")) { <a asp-area="" asp-controller="Dashboard" asp-action="Index">Panel de gestión</a> } else { <a asp-area="" asp-controller="Mascotas" asp-action="Index">Mis mascotas</a> }
<a asp-area="" asp-controller="Citas" asp-action="Index">Mis citas</a>
</div>
</div>
<div class="footer-bottom">© @DateTime.Now.Year Huellitas · Clínica veterinaria <span>Hecho para cuidar ♡</span>
</div>
</div>
</footer>
<script src="~/lib/jquery/dist/jquery.min.js">
</script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js">
</script>
<script src="~/js/site.js" asp-append-version="true">
</script>@await RenderSectionAsync("Scripts", required:false)</body>
</html>
