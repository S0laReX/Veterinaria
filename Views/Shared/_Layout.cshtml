<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Veterinaria
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>


<body>

    <header>

        <nav class="navbar
            navbar-expand-lg
            navbar-dark
            bg-dark
            shadow-sm">

            <div class="container">

                <!-- LOGO -->
                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">

                    Veterinaria

                </a>


                <!-- BOTÓN RESPONSIVE -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar">

                    <span class="navbar-toggler-icon">
                    </span>

                </button>


                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    <!-- MENÚ IZQUIERDO -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">

                                Inicio

                            </a>

                        </li>


                        <!-- =================================================
                         MENÚ DEL ADMINISTRADOR
                         ================================================= -->
                        @if (User.Identity?.IsAuthenticated == true
                                                && User.IsInRole("Administrador"))
                        {
                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Servicios"
                                   asp-action="Index">

                                    Servicios

                                </a>

                            </li>
                        }


                        <!-- =================================================
                         MENÚ DEL CLIENTE
                         ================================================= -->
                        @if (User.Identity?.IsAuthenticated == true
                                                && User.IsInRole("Cliente"))
                        {
                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-area="Identity"
                                   asp-page="/Account/Manage/Index">

                                    Mi cuenta

                                </a>

                            </li>

                            
    @*
        Más adelante:
        Mascotas
        Citas
    *@
                        }

                    </ul>


                    <!-- LOGIN / LOGOUT -->
                    <partial name="_LoginPartial" />

                </div>

            </div>

        </nav>

    </header>


    <main role="main">

        @RenderBody()

    </main>


    <footer class="border-top
        text-muted
        mt-5
        py-4">

        <div class="container">

            &copy; @DateTime.Now.Year - Veterinaria

        </div>

    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js">
    </script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js">
    </script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>


    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>

</html>