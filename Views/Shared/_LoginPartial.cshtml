@using Microsoft.AspNetCore.Identity
@using Veterinaria.Models
@inject UserManager<ApplicationUser> UserManager
<ul class="navbar-nav align-items-xl-center">
@if(User.Identity?.IsAuthenticated == true) {
var usuario = await UserManager.GetUserAsync(User);
<li class="nav-item"><a class="nav-link account-link" asp-area="Identity" asp-page="/Account/Manage/Index">@(string.IsNullOrWhiteSpace(usuario?.NombreCompleto) ? "Mi cuenta" : usuario.NombreCompleto)</a></li>
<li class="nav-item"><form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post"><button class="btn btn-outline-success btn-sm" type="submit">Salir</button></form></li>
} else {
<li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Iniciar sesión</a></li><li class="nav-item"><a class="btn btn-success ms-xl-2" asp-area="Identity" asp-page="/Account/Register">Crear cuenta ↗</a></li>
}
</ul>
