@model IEnumerable<Veterinaria.Models.ServicioVeterinario>
@{ ViewData["Title"] = "Un hogar para su bienestar"; }
<section class="container hero-section">
<div class="row align-items-center g-5">
<div class="col-lg-6">
<span class="eyebrow">
<span class="status-dot">
</span> Pequeñas huellas, grandes amigos</span>
<h1>Su felicidad.<br />Tu tranquilidad.<br />
<em>Nuestro cuidado.</em>
</h1>
<p class="hero-description">Son parte de tu familia. Acompañamos su bienestar con atención veterinaria y un espacio pensado para cuidarlos con cariño.</p>
<div class="d-flex flex-wrap gap-3 mt-4">
@if (User.IsInRole("Administrador")) { <a class="btn btn-success btn-lg" asp-controller="Dashboard" asp-action="Index">Ir al panel de gestión <span aria-hidden="true">↗</span>
</a> }
else if (User.IsInRole("Cliente")) { <a class="btn btn-success btn-lg" asp-controller="Citas" asp-action="Create">Solicitar una cita <span aria-hidden="true">↗</span>
</a> }
else { <a class="btn btn-success btn-lg" asp-area="Identity" asp-page="/Account/Register">Comenzar su cuidado <span aria-hidden="true">↗</span>
</a> }
<a class="btn btn-outline-success btn-lg" asp-action="Servicios">Explorar servicios</a>
</div>
<div class="hero-note">
<span aria-hidden="true">♡</span> Un mismo lugar para sus mascotas, servicios y citas.</div>
</div>
<div class="col-lg-6">
<div class="hero-art">
<img src="~/images/companions.svg" alt="Ilustración de un perro y un gato juntos" width="600" height="550"/>
<div class="care-label">
<span class="care-heart" aria-hidden="true">♥</span>
<div>
<strong>En buenas manos</strong>
<small>Cuidado que deja huella</small>
</div>
</div>
</div>
</div>
</div>
</section>
<div class="care-strip">
<div class="container d-flex flex-wrap justify-content-between gap-3">
<span>♡ Atención con cariño</span>
<span>✧ Bienestar en cada etapa</span>
<span>⌂ Un espacio para su cuidado</span>
<span>↗ Citas desde tu cuenta</span>
</div>
</div>
<section class="container py-5" id="servicios">
<div class="section-heading">
<div>
<span class="eyebrow">Para quien más quieres</span>
<h2 class="mt-2">El cuidado que necesita.</h2>
</div>
<a asp-action="Servicios" class="text-link">Ver todos los servicios ↗</a>
</div>
<div class="row g-4 mt-1">
@if (!Model.Any()) { <div class="col-12">
<div class="empty-state">Estamos preparando nuestro catálogo. Crea tu cuenta y registra a tu mascota para comenzar.</div>
</div> }
@foreach (var servicio in Model.Take(3)) { <div class="col-md-4">
<article class="service-tile h-100">
<span class="service-symbol" aria-hidden="true">✚</span>
<h3>@servicio.Nombre</h3>
<p>@servicio.Descripcion</p>
<div class="d-flex justify-content-between align-items-center mt-auto">
<strong>@Moneda.Bolivianos(servicio.Precio)</strong>
<a asp-controller="Citas" asp-action="Create" asp-route-servicioId="@servicio.Id" aria-label="Solicitar cita para @servicio.Nombre" class="round-link">↗</a>
</div>
</article>
</div> }
</div>
</section>
<section class="container pb-5">
<div class="journey-panel">
<div class="row g-5 align-items-center">
<div class="col-lg-5">
<span class="eyebrow">Fácil para ti. Mejor para ellos.</span>
<h2 class="mt-3">Más tiempo juntos,<br />menos complicaciones.</h2>
<p>Organiza su próxima visita desde tu cuenta, a tu ritmo.</p>
<a class="btn btn-success mt-2" asp-controller="@(User.IsInRole("Administrador") ? "Dashboard" : "Mascotas")" asp-action="Index">@(User.IsInRole("Administrador") ? "Ver actividad de la clínica" : User.IsInRole("Cliente") ? "Ver mis mascotas" : "Registrar a mi mascota") ↗</a>
</div>
<div class="col-lg-7">
<div class="journey-step">
<span>01</span>
<div>
<h3>Conozcamos a tu compañero</h3>
<p>Registra su nombre, especie y los detalles de su cuidado.</p>
</div>
</div>
<div class="journey-step">
<span>02</span>
<div>
<h3>Elige su próxima atención</h3>
<p>Selecciona una mascota, un servicio y la fecha de la cita.</p>
</div>
</div>
<div class="journey-step">
<span>03</span>
<div>
<h3>Todo a mano</h3>
<p>Consulta tus citas y su estado desde tu espacio personal.</p>
</div>
</div>
</div>
</div>
</div>
</section>
