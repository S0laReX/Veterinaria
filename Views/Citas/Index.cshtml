@model IEnumerable<Veterinaria.Models.Cita>
@{ var admin = User.IsInRole("Administrador"); ViewData["Title"] = admin ? "Gestión de citas" : "Mis citas"; }
<div class="container py-5">
<div class="d-flex justify-content-between align-items-center mb-4">
<div>
<span class="eyebrow">@(admin ? "Administración" : "El cuidado de tus compañeros")</span>
<h1 class="mt-2">@ViewData["Title"]</h1>
<p class="text-muted">@(admin ? "Consulta las reservas y actualiza su estado." : "Consulta cuándo será su próxima visita y el estado de cada cita.")</p>
</div>
@if(!admin) { <a class="btn btn-success" asp-action="Create">Solicitar una cita ↗</a> }</div>
@{ ViewBag.Resultados = Model.Count(); }
    <partial name="_FiltrosListado" model="(FiltrosListado)ViewBag.Filtros" />
    @if(!Model.Any()) { <div class="empty-state">
<h2 class="h4">No encontramos citas para mostrar</h2>
<p class="mb-0">@(admin ? "Prueba con otros filtros. Las solicitudes de los clientes aparecerán aquí." : "Prueba con otros filtros o solicita una nueva visita para tu mascota.")</p>
</div> }
else { <div class="card p-3">
<p class="price-caption">Precios en bolivianos según la tarifa actual del servicio.</p>
<div class="table-responsive">
<table class="table align-middle">
<thead>
<tr>
<th>Mascota</th>@if(admin) { <th>Cliente</th> }<th>Servicio</th>
<th>Precio del servicio</th>
<th>Fecha y hora</th>
<th>Estado</th>@if(admin) { <th>Actualizar estado</th> }</tr>
</thead>
<tbody>
@foreach(var cita in Model) {
var badge = cita.Estado == "Atendida" ? "bg-success" : cita.Estado == "Cancelada" ? "bg-danger" : "bg-warning text-dark";
<tr>
<td class="fw-bold">@cita.Mascota?.Nombre</td>@if(admin) { <td>@cita.Usuario?.Email</td> }<td>@cita.ServicioVeterinario?.Nombre</td>
<td class="price-cell">@Moneda.Bolivianos(cita.ServicioVeterinario?.Precio ?? 0)</td>
<td>@cita.FechaCita.ToString("dd/MM/yyyy HH:mm")</td>
<td>
<span class="badge @badge">@cita.Estado</span>
</td>
@if(admin) { <td>
<form asp-action="CambiarEstado" method="post" class="d-flex gap-2">
<input type="hidden" name="id" value="@cita.Id"/>
<input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
<label class="visually-hidden" for="estado-@cita.Id">Estado de la cita de @cita.Mascota?.Nombre</label>
<select name="estado" id="estado-@cita.Id" class="form-select form-select-sm">@foreach(var estado in new[] { "Pendiente", "Atendida", "Cancelada" }) { <option value="@estado" selected="@(estado == cita.Estado)">@estado</option> }</select>
<button class="btn btn-outline-success btn-sm" type="submit">Guardar</button>
</form>
</td> }</tr>
}
</tbody>
</table>
</div>
</div> }
</div>
