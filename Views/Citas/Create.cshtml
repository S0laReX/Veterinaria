@model Veterinaria.Models.Cita

@{
    ViewData["Title"] = "Solicitar una cita";
    var servicios = (IEnumerable<ServicioVeterinario>?)ViewBag.ServiciosDisponibles ?? [];
    var seleccionado = servicios.FirstOrDefault(s => s.Id == Model?.ServicioVeterinarioId);
}

<div class="container py-5">

    <!-- Encabezado -->
    <div class="row justify-content-center mb-4">
        <div class="col-lg-9">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center"
                     style="width: 60px; height: 60px;">
                    <i class="bi bi-calendar-plus fs-3"></i>
                </div>

                <div>
                    <h1 class="fw-bold mb-1">Solicitar una cita</h1>
                    <p class="text-muted mb-0">
                        Reserva una atención para tu mascota.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Formulario -->
    <div class="row justify-content-center">

        <div class="col-lg-9">

            <div class="card border-0 shadow-lg">

                <div class="card-header bg-success text-white py-3">
                    <h5 class="mb-0">
                        <i class="bi bi-calendar-heart me-2"></i>
                        Datos de la cita
                    </h5>
                </div>

                <div class="card-body p-4 p-lg-5">

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"
                         role="alert"></div>

                    <form asp-action="Create" method="post">

                        @Html.AntiForgeryToken()

                        <div class="row g-4">

                            <!-- Mascota -->
                            <div class="col-md-6">

                                <label asp-for="MascotaId"
                                       class="form-label fw-semibold">
                                    <i class="bi bi-heart-fill text-danger me-1"></i>
                                    Mascota
                                </label>

                                <select asp-for="MascotaId"
                                        asp-items="ViewBag.Mascotas"
                                        class="form-select form-select-lg">

                                    <option value="">
                                        Elige a tu compañero
                                    </option>

                                </select>

                                <div class="form-text">
                                    Selecciona la mascota que recibirá la atención.
                                </div>

                                <span asp-validation-for="MascotaId"
                                      class="text-danger"></span>

                            </div>

                            <!-- Servicio -->
                            <div class="col-md-6">

                                <label asp-for="ServicioVeterinarioId"
                                       class="form-label fw-semibold">

                                    <i class="bi bi-hospital text-success me-1"></i>
                                    Servicio veterinario

                                </label>

                                <select asp-for="ServicioVeterinarioId" class="form-select form-select-lg" aria-describedby="precio-ayuda">
                                    <option value="">Elige el servicio que necesita</option>
                                    @foreach (var servicio in servicios)
                                    {
                                        <option value="@servicio.Id" data-precio="@Moneda.Bolivianos(servicio.Precio)">@servicio.Nombre · @Moneda.Bolivianos(servicio.Precio)</option>
                                    }
                                </select>
                                <div class="booking-price" aria-live="polite" aria-atomic="true">
                                    <span>Precio de la atención</span>
                                    <strong id="precio-cita">@(seleccionado == null ? "Elige un servicio" : Moneda.Bolivianos(seleccionado.Precio))</strong>
                                    <small id="precio-ayuda">Tarifa actual del servicio, expresada en bolivianos.</small>
                                </div>

                                <div class="form-text">
                                    Selecciona el servicio que necesita tu mascota.
                                </div>

                                <span asp-validation-for="ServicioVeterinarioId"
                                      class="text-danger"></span>

                            </div>

                            <!-- Fecha -->
                            <div class="col-12">

                                <label asp-for="FechaCita"
                                       class="form-label fw-semibold">

                                    <i class="bi bi-calendar-event text-primary me-1"></i>
                                    Fecha y hora de la cita

                                </label>

                                <input asp-for="FechaCita"
                                       value="@(Model != null && Model.FechaCita != default ? Model.FechaCita.ToString("yyyy-MM-ddTHH:mm") : "")"
                                       type="datetime-local"
                                       class="form-control form-control-lg"
                                       id="fechaCita" />

                                <div class="form-text">
                                    Selecciona una fecha y hora posterior al momento actual.
                                </div>

                                <span asp-validation-for="FechaCita"
                                      class="text-danger"></span>

                            </div>

                            <!-- Información -->
                            <div class="col-12">

                                <div class="alert alert-info border-0 d-flex align-items-start gap-3">

                                    <i class="bi bi-info-circle-fill fs-4"></i>

                                    <div>
                                        <strong>Información importante</strong>

                                        <p class="mb-0 mt-1">
                                            La cita quedará registrada inicialmente como
                                            <strong>Pendiente</strong>.
                                            El equipo de la clínica podrá gestionar,
                                            atender o cancelar la cita.
                                        </p>
                                    </div>

                                </div>

                            </div>

                        </div>

                        <!-- Botones -->
                        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary btn-lg">

                                <i class="bi bi-arrow-left me-1"></i>
                                Volver a mis citas

                            </a>

                            <button type="submit"
                                    class="btn btn-success btn-lg px-4">

                                <i class="bi bi-calendar-check me-1"></i>
                                Solicitar cita

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const servicio = document.getElementById("ServicioVeterinarioId");
            const precio = document.getElementById("precio-cita");
            const actualizarPrecio = () => {
                precio.textContent = servicio.selectedOptions[0]?.dataset.precio || "Elige un servicio";
            };
            servicio.addEventListener("change", actualizarPrecio);
            actualizarPrecio();

            const inputFecha = document.getElementById("fechaCita");

            if (!inputFecha) return;

            const ahora = new Date();

            // Ajustar a la hora local para datetime-local
            ahora.setMinutes(
                ahora.getMinutes() - ahora.getTimezoneOffset()
            );

            inputFecha.min = ahora.toISOString().slice(0, 16);
        });

    </script>
}