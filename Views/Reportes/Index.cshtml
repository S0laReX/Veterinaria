@model IEnumerable<Veterinaria.Models.ApplicationUser>

@{
    ViewData["Title"] = "Reportes";
}

<div class="container py-4">

    <div class="mb-4">

        <h1 class="fw-bold">
            <i class="bi bi-file-earmark-pdf"></i>
            Reportes
        </h1>

        <p class="text-muted">
            Generación de reportes administrativos en formato PDF.
        </p>

    </div>

    <div class="row g-4">

        <!-- REPORTE GENERAL -->

        <div class="col-lg-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center p-4">

                    <i class="bi bi-calendar2-week display-3 text-primary"></i>

                    <h4 class="mt-3">
                        Reporte General de Citas
                    </h4>

                    <p class="text-muted">
                        Lista todas las citas registradas,
                        incluyendo mascota, cliente, servicio,
                        fecha y estado.
                    </p>

                    <a asp-action="CitasGeneral"
                       class="btn btn-primary">

                        <i class="bi bi-file-earmark-pdf"></i>
                        Generar PDF

                    </a>

                </div>

            </div>

        </div>

        <!-- CLIENTE -->

        <div class="col-lg-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="text-center">

                        <i class="bi bi-person-lines-fill display-3 text-success"></i>

                        <h4 class="mt-3">
                            Citas por Cliente
                        </h4>

                        <p class="text-muted">
                            Selecciona un cliente para generar
                            su historial de citas.
                        </p>

                    </div>

                    <form asp-action="CitasPorCliente"
                          method="get">

                        <div class="mb-3">

                            <label for="buscar-cliente" class="form-label">Buscar cliente</label>
                            <input id="buscar-cliente" type="search" class="form-control mb-3" placeholder="Nombre o correo" aria-describedby="clientes-encontrados" />
                            <label for="cliente-reporte" class="form-label">Cliente</label>

                            <select id="cliente-reporte" name="usuarioId"
                                    class="form-select"
                                    required>

                                <option value="">
                                    Seleccione un cliente
                                </option>

                                @foreach (var cliente in Model)
                                {
                                    <option value="@cliente.Id">
                                        @(string.IsNullOrWhiteSpace(cliente.NombreCompleto) ? cliente.Email : $"{cliente.NombreCompleto} · {cliente.Email}")
                                    </option>
                                }

                            </select>
                            <small id="clientes-encontrados" class="form-text" role="status"></small>

                        </div>

                        <button type="submit"
                                class="btn btn-success w-100">

                            <i class="bi bi-file-earmark-pdf"></i>
                            Generar PDF

                        </button>

                    </form>

                </div>

            </div>

        </div>

        <!-- SERVICIOS -->

        <div class="col-lg-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center p-4">

                    <i class="bi bi-bar-chart-fill display-3 text-warning"></i>

                    <h4 class="mt-3">
                        Servicios Más Solicitados
                    </h4>

                    <p class="text-muted">
                        Muestra los servicios ordenados
                        por cantidad de citas.
                    </p>

                    <a asp-action="ServiciosMasSolicitados"
                       class="btn btn-warning">

                        <i class="bi bi-file-earmark-pdf"></i>
                        Generar PDF

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>
@section Scripts {
    <script>
        const buscador = document.getElementById("buscar-cliente");
        const clientes = document.getElementById("cliente-reporte");
        const opciones = [...clientes.options].slice(1).map(o => ({ value: o.value, text: o.textContent.trim() }));
        const normalizar = texto => texto.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();
        buscador.addEventListener("input", () => {
            const seleccionado = clientes.value;
            const encontrados = opciones.filter(o => normalizar(o.text).includes(normalizar(buscador.value.trim())));
            clientes.replaceChildren(new Option("Selecciona un cliente", ""));
            encontrados.forEach(o => clientes.add(new Option(o.text, o.value, false, o.value === seleccionado)));
            document.getElementById("clientes-encontrados").textContent = `${encontrados.length} clientes encontrados`;
        });
    </script>
}
