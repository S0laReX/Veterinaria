@model IEnumerable<Veterinaria.Models.ApplicationUser>

@{
    ViewData["Title"] = "Reportes";
}

<div class="container py-4">

    <div class="mb-4">

        <h1 class="fw-bold">
            <i class="bi bi-file-earmark-pdf"></i>
            Reportes
        </h1>

        <p class="text-muted">
            Generación de reportes administrativos en formato PDF.
        </p>

    </div>

    <div class="row g-4">

        <!-- REPORTE GENERAL -->

        <div class="col-lg-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center p-4">

                    <i class="bi bi-calendar2-week display-3 text-primary"></i>

                    <h4 class="mt-3">
                        Reporte General de Citas
                    </h4>

                    <p class="text-muted">
                        Lista todas las citas registradas,
                        incluyendo mascota, cliente, servicio,
                        fecha y estado.
                    </p>

                    <a asp-action="CitasGeneral"
                       class="btn btn-primary">

                        <i class="bi bi-file-earmark-pdf"></i>
                        Generar PDF

                    </a>

                </div>

            </div>

        </div>

        <!-- CLIENTE -->

        <div class="col-lg-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="text-center">

                        <i class="bi bi-person-lines-fill display-3 text-success"></i>

                        <h4 class="mt-3">
                            Citas por Cliente
                        </h4>

                        <p class="text-muted">
                            Selecciona un cliente para generar
                            su historial de citas.
                        </p>

                    </div>

                    <form asp-action="CitasPorCliente"
                          method="get">

                        <div class="mb-3">

                            <label class="form-label">
                                Cliente
                            </label>

                            <select name="usuarioId"
                                    class="form-select"
                                    required>

                                <option value="">
                                    Seleccione un cliente
                                </option>

                                @foreach (var cliente in Model)
                                {
                                    <option value="@cliente.Id">
                                        @cliente.Email
                                    </option>
                                }

                            </select>

                        </div>

                        <button type="submit"
                                class="btn btn-success w-100">

                            <i class="bi bi-file-earmark-pdf"></i>
                            Generar PDF

                        </button>

                    </form>

                </div>

            </div>

        </div>

        <!-- SERVICIOS -->

        <div class="col-lg-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center p-4">

                    <i class="bi bi-bar-chart-fill display-3 text-warning"></i>

                    <h4 class="mt-3">
                        Servicios Más Solicitados
                    </h4>

                    <p class="text-muted">
                        Muestra los servicios ordenados
                        por cantidad de citas.
                    </p>

                    <a asp-action="ServiciosMasSolicitados"
                       class="btn btn-warning">

                        <i class="bi bi-file-earmark-pdf"></i>
                        Generar PDF

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>