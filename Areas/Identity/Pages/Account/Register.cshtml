@page
@model Veterinaria.Areas.Identity.Pages.Account.RegisterModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{ ViewData["Title"] = "Crear cuenta"; }
<div class="auth-card card">
<div class="card-body p-4 p-md-5">
<span class="eyebrow">Bienvenido a Huellitas</span>
<h1 class="mt-3">Su cuidado empieza contigo.</h1>
<p class="text-muted">Crea tu cuenta para registrar mascotas y solicitar citas.</p>
<form method="post">
<div asp-validation-summary="ModelOnly" class="text-danger" role="alert">
</div>
<label asp-for="Input.NombreCompleto" class="form-label">
</label>
<input asp-for="Input.NombreCompleto" class="form-control" autocomplete="name"/>
<span asp-validation-for="Input.NombreCompleto" class="text-danger">
</span>
<label asp-for="Input.Email" class="form-label mt-3">
</label>
<input asp-for="Input.Email" class="form-control" autocomplete="email"/>
<span asp-validation-for="Input.Email" class="text-danger">
</span>
<label asp-for="Input.Password" class="form-label mt-3">
</label>
<input asp-for="Input.Password" class="form-control" autocomplete="new-password"/>
<span asp-validation-for="Input.Password" class="text-danger">
</span>
<div class="form-text">Al menos 8 caracteres, mayúscula, minúscula, número y símbolo.</div>
<label asp-for="Input.ConfirmPassword" class="form-label mt-3">
</label>
<input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password"/>
<span asp-validation-for="Input.ConfirmPassword" class="text-danger">
</span>
<button class="btn btn-success w-100 mt-4" type="submit">Crear mi cuenta</button>
<p class="mt-3 mb-0">¿Ya tienes cuenta? <a asp-page="Login">Inicia sesión</a>
</p>
</form>
</div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
