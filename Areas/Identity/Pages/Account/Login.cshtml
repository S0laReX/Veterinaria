@page
@model Veterinaria.Areas.Identity.Pages.Account.LoginModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{ ViewData["Title"] = "Iniciar sesión"; }
<div class="auth-card card">
<div class="card-body p-4 p-md-5">
<span class="eyebrow">Qué bueno verte de nuevo</span>
<h1 class="mt-3">Un lugar para su cuidado.</h1>
<p class="text-muted">Ingresa para gestionar tus mascotas y sus próximas visitas.</p>
<form method="post">
<div asp-validation-summary="ModelOnly" class="text-danger" role="alert">
</div>
<label asp-for="Input.Email" class="form-label">
</label>
<input asp-for="Input.Email" class="form-control" autocomplete="username"/>
<span asp-validation-for="Input.Email" class="text-danger">
</span>
<label asp-for="Input.Password" class="form-label mt-3">
</label>
<input asp-for="Input.Password" class="form-control" autocomplete="current-password"/>
<span asp-validation-for="Input.Password" class="text-danger">
</span>
<div class="form-check mt-3">
<input asp-for="Input.RememberMe" class="form-check-input"/>
<label asp-for="Input.RememberMe" class="form-check-label">
</label>
</div>
<button class="btn btn-success w-100 mt-4" type="submit">Iniciar sesión</button>
<p class="mt-3 mb-0">¿Es tu primera visita? <a asp-page="Register">Crea tu cuenta</a>
</p>
</form>
</div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
